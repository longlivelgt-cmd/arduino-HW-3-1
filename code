#include <Arduino.h>
#include <math.h>

// Pins
const int RED_PIN = 9;
const int GREEN_PIN = 10;
const int BLUE_PIN = 11;
const int BUTTON_PIN = 2;

// Button settings
const unsigned long DEBOUNCE_TIME = 30;
const unsigned long LONG_PRESS_TIME = 1000;

// Button states
bool lastButtonReading = HIGH;
bool stableButtonState = HIGH;

unsigned long lastDebounceTime = 0;
unsigned long buttonPressStart = 0;

bool longPressHandled = false;

// Modes
// 0 = Constant
// 1 = Breathing
// 2 = Aurora
// 3 = Blink
// 4 = Fire

const int MODE_COUNT = 5;
int currentMode = 0;

// Colors (ROYGBV)
// Common Anode: 0 = ON, 255 = OFF

const int colors[][3] = {
  {0, 255, 255},       // Red
  {0, 120, 255},       // Orange
  {0, 30, 255},        // Yellow
  {255, 0, 255},       // Green
  {255, 255, 0},       // Blue
  {120, 255, 120}      // Violet
};

const int NUM_COLORS = 6;
int currentColor = 0;

// Setup
void setup() {
  pinMode(RED_PIN, OUTPUT);
  pinMode(GREEN_PIN, OUTPUT);
  pinMode(BLUE_PIN, OUTPUT);

  // Button connects to GND
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  setColor(
    colors[currentColor][0],
    colors[currentColor][1],
    colors[currentColor][2]
  );
}

// Main loop
void loop() {
  handleButton();
  updateLightMode();
}

// Button control
void handleButton() {
  bool reading = digitalRead(BUTTON_PIN);
  unsigned long now = millis();

  // Check for button changes
  if (reading != lastButtonReading) {
    lastDebounceTime = now;
  }

  // Wait for the signal to settle
  if (now - lastDebounceTime >= DEBOUNCE_TIME) {
    if (reading != stableButtonState) {
      stableButtonState = reading;

      // Button pressed
      if (stableButtonState == LOW) {
        buttonPressStart = now;
        longPressHandled = false;
      }
      // Button released
      else {
        if (!longPressHandled) {
          changeColor();
        }
      }
    }

    // Change mode after holding for 1 second
    if (stableButtonState == LOW &&
        !longPressHandled &&
        now - buttonPressStart >= LONG_PRESS_TIME) {
      changeMode();
      longPressHandled = true;
    }
  }

  lastButtonReading = reading;
}

// Change color
void changeColor() {
  currentColor++;

  if (currentColor >= NUM_COLORS) {
    currentColor = 0;
  }
}

// Change mode
void changeMode() {
  currentMode++;

  if (currentMode >= MODE_COUNT) {
    currentMode = 0;
  }
}

// Light modes
void updateLightMode() {
  switch (currentMode) {

    // Mode 0: Constant
    case 0:
      setColor(
        colors[currentColor][0],
        colors[currentColor][1],
        colors[currentColor][2]
      );
      break;

    // Mode 1: Breathing
    case 1: {
      unsigned long cycleTime = 3000;
      unsigned long t = millis() % cycleTime;

      float angle = (float)t / cycleTime * 2.0f * 3.14159265f;
      float breathFactor = (sin(angle) + 1.0f) / 2.0f;
      breathFactor = 0.1f + (breathFactor * 0.9f);

      int rBase = colors[currentColor][0];
      int gBase = colors[currentColor][1];
      int bBase = colors[currentColor][2];

      float rIntensity = (255 - rBase) * breathFactor;
      float gIntensity = (255 - gBase) * breathFactor;
      float bIntensity = (255 - bBase) * breathFactor;

      int r = 255 - (int)rIntensity;
      int g = 255 - (int)gIntensity;
      int b = 255 - (int)bIntensity;

      setColor(r, g, b);
      break;
    }

    // Mode 2: Aurora
    case 2: {
      unsigned long t = millis();
      unsigned long cycleTime = 3000;

      float angleR = (float)(t % cycleTime) / cycleTime * 2.0f * 3.14159265f;
      float angleG = (float)((t + cycleTime / 3) % cycleTime) / cycleTime * 2.0f * 3.14159265f;
      float angleB = (float)((t + (cycleTime * 2) / 3) % cycleTime) / cycleTime * 2.0f * 3.14159265f;

      float rIntensity = (sin(angleR) + 1.0f) / 2.0f * 0.25f;
      float gIntensity = (sin(angleG) + 1.0f) / 2.0f;
      float bIntensity = (sin(angleB) + 1.0f) / 2.0f;

      int r = 255 - (int)(rIntensity * 255);
      int g = 255 - (int)(gIntensity * 255);
      int b = 255 - (int)(bIntensity * 255);

      setColor(r, g, b);
      break;
    }

    // Mode 3: Blink
    case 3: {
      static unsigned long lastBlink = 0;
      static bool blinkOn = false;
      unsigned long now = millis();

      // Blink every 400 ms
      if (now - lastBlink >= 400) {
        lastBlink = now;
        blinkOn = !blinkOn;
      }

      if (blinkOn) {
        setColor(
          colors[currentColor][0],
          colors[currentColor][1],
          colors[currentColor][2]
        );
      } else {
        setColor(255, 255, 255);
      }
      break;
    }

    // Mode 4: Fire
    case 4: {
      static unsigned long lastFlicker = 0;
      unsigned long now = millis();

      // Change brightness every 50 ms
      if (now - lastFlicker >= 50) {
        lastFlicker = now;

        int rBase = colors[currentColor][0];
        int gBase = colors[currentColor][1];
        int bBase = colors[currentColor][2];

        // Random brightness from 70% to 100%
        float flickerFactor = random(70, 101) / 100.0f;

        float rIntensity = (255 - rBase) * flickerFactor;
        float gIntensity = (255 - gBase) * flickerFactor;
        float bIntensity = (255 - bBase) * flickerFactor;

        int r = 255 - (int)rIntensity;
        int g = 255 - (int)gIntensity;
        int b = 255 - (int)bIntensity;

        setColor(r, g, b);
      }
      break;
    }
  }
}

// Set RGB color
void setColor(int red, int green, int blue) {
  analogWrite(RED_PIN, red);
  analogWrite(GREEN_PIN, green);
  analogWrite(BLUE_PIN, blue);
}
